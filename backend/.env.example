# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Connection (MongoDB + Prisma)
DATABASE_URL=
# Brevo SMTP Configuration
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_FROM_EMAIL=your_verified_sender_email
BREVO_FROM_NAME=HireNest

# Access Token
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key
JWT_ACCESS_EXPIRES_IN=1d

# Refresh Token
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key
JWT_REFRESH_EXPIRES_IN=7d

# Email Verification
JWT_EMAIL_VERIFICATION_SECRET=your_super_secret_email_verification_key
JWT_EMAIL_VERIFICATION_EXPIRES_IN=24h

# Admin Seeder Credentials
ADMIN_NAME="Super Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="YourStrongPassword"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


